# Configuración de MLflow (MLflow 3.x usa aliases en lugar de stages).
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
MLFLOW_EXPERIMENT_NAME=HousePricePrediction
MLFLOW_MODEL_NAME=HousePriceModel
MLFLOW_MODEL_ALIAS=champion

# Backend (FastAPI).
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
LOG_LEVEL=INFO

# Frontend / CORS (varios orígenes separados por coma).
FRONTEND_URL=http://localhost:3000,http://127.0.0.1:3000

# URL de la API que el frontend incorpora en tiempo de compilación.
NEXT_PUBLIC_API_URL=http://localhost:8000
